  <!-- wire node 0: spherical joint = revolute-X then revolute-Y through a massless dummy -->
  <joint name="wire_link_0_joint_x" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.000000"/>
    <axis xyz="1 0 0"/>
    <limit effort="0.0" lower="-1.5708" upper="1.5708" velocity="100.0"/>
    <dynamics damping="0.005"/>
